# FE ở /, API ở /api, cùng một origin (Documents/21 V38). SITE_ADDRESS: tên miền trên VPS, :80 trên máy.
{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Kênh SSE do tiến trình realtime phục vụ (#33). Chỉ route này, /metrics của realtime không ra ngoài.
	handle /api/v1/notification/stream* {
		reverse_proxy realtime:3002
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# FE là SPA (createBrowserRouter): đường dẫn không phải file thì trả index.html.
	handle {
		root * /srv/fe
		try_files {path} /index.html
		file_server
	}
}
