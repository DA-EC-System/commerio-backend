# Chép thành alertmanager.yml (đã gitignore) và điền giá trị thật; dùng chung SMTP Brevo với worker
# (deploy/staging/README.md mục "Cảnh báo qua email"). Không commit bản đã điền.
global:
  smtp_smarthost: smtp-relay.brevo.com:587
  smtp_from: dia-chi-da-xac-minh@gmail.com
  smtp_auth_username: login@smtp-brevo.com
  smtp_auth_password: smtp-key
  smtp_require_tls: true

route:
  receiver: email
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

receivers:
  - name: email
    email_configs:
      - to: hop-thu-nhom@gmail.com
        send_resolved: true
