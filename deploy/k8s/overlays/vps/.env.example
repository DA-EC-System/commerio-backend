# Chép thành .env (đã gitignore) trên máy VPS. Viết giá trị KHÔNG có dấu nháy.
# Cùng các biến của deploy/staging/.env.example (#37), trừ IMAGE, IMAGE_TAG, SITE_ADDRESS, HTTP_PORT, FE_DIST.

# Chuỗi Session pooler của Supabase (cổng 5432)
DATABASE_URL=

# Cặp khoá Ed25519 dạng PEM, xuống dòng viết \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Tuỳ chọn (mặc định ở src/shared/config/env.ts)
# PAYMENT_CREDENTIALS_KEY=
# PUBLIC_API_URL=
# Gốc URL công khai của FE, không có / ở cuối: link mời nhân viên <PUBLIC_WEB_URL>/tham-gia#<token>, trang khách quay về sau khi trả tiền.
# Bỏ trống thì BE dùng http://localhost:5173, link gửi ra ngoài sẽ hỏng; VPS phải đặt, vd https://<tên miền staging>. Không để dòng trống "PUBLIC_WEB_URL=" (BE không khởi động).
# PUBLIC_WEB_URL=
