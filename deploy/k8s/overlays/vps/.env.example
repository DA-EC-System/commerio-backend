# Chép thành .env (đã gitignore) trên máy VPS. Viết giá trị KHÔNG có dấu nháy.
# Cùng các biến của deploy/staging/.env.example (#37), trừ IMAGE, IMAGE_TAG, SITE_ADDRESS, HTTP_PORT, FE_DIST.

# Chuỗi Session pooler của Supabase (cổng 5432)
DATABASE_URL=

# Cặp khoá Ed25519 dạng PEM, xuống dòng viết \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Tuỳ chọn (mặc định ở src/shared/config/env.ts)
# PAYMENT_CREDENTIALS_KEY=
# PUBLIC_API_URL=
