# Chép thành .env (đã gitignore) rồi điền. Viết giá trị KHÔNG có dấu nháy: Kustomize giữ nguyên dấu nháy trong giá trị.
# Mỗi dòng thành một biến của api, worker, realtime (Secret app-env).

# DB Docker của máy (npm run infra:up), database riêng cho cluster: createdb -U commerio commerio_k8s
# Chuỗi postgres:// tới host.docker.internal:5432/commerio_k8s, user và mật khẩu dev như deploy/compose.yaml
DATABASE_URL=

# Bắt buộc: image chạy NODE_ENV=production. Sinh như deploy/staging/.env.example (#37); xuống dòng trong PEM viết \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Tuỳ chọn (mặc định ở src/shared/config/env.ts)
# PAYMENT_CREDENTIALS_KEY=
# PUBLIC_API_URL=
# LOG_LEVEL=info
