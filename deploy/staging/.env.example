# Chép thành deploy/staging/.env rồi điền. Không commit .env (đã gitignore).
# File này vừa là biến cho docker compose vừa là env_file của api, worker, realtime.

# Image: tag theo commit (sha-<7 ký tự>) hoặc develop. Thử trên máy với image tự build: IMAGE=commerio-backend, IMAGE_TAG=local
IMAGE=ghcr.io/da-ec-system/commerio-backend
IMAGE_TAG=develop

# Caddy. VPS: SITE_ADDRESS=<tên miền>, bỏ HTTP_PORT/HTTPS_PORT (mặc định 80, 443).
# Trên máy: chỉ mở cho chính máy mình (127.0.0.1), rồi vào http://localhost:8037
SITE_ADDRESS=:80
HTTP_PORT=127.0.0.1:8037
HTTPS_PORT=127.0.0.1:8437
# Thư mục dist/ của FE đã build (đường dẫn tuyệt đối, hoặc tương đối với deploy/staging/)
FE_DIST=./site

# Database. Staging: chuỗi Session pooler của Supabase (cổng 5432, user postgres.<mã>).
# Thử trên máy trước khi merge: postgres://commerio:commerio@host.docker.internal:5432/commerio_<n>
DATABASE_URL=

# Cặp khoá Ed25519 ký access token, bắt buộc vì container chạy NODE_ENV=production.
# Sinh: openssl genpkey -algorithm ed25519 -out jwt.pem && openssl pkey -in jwt.pem -pubout ; xuống dòng viết \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Đổi khi cần (mặc định ở src/shared/config/env.ts): Swagger /api/docs bật sẵn, 20 lần đăng nhập/15 phút mỗi IP
# API_DOCS_ENABLED=true
# AUTH_RATE_LIMIT=20
# LOG_LEVEL=info
