# Sao chép thành .env rồi sửa. Không commit .env.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=3000
API_OPS_PORT=9464
WORKER_PORT=3001
REALTIME_PORT=3002
# Cổng vận hành của realtime (/health, /metrics); cổng stream ở trên là cổng duy nhất proxy đưa ra ngoài
REALTIME_OPS_PORT=3003

# Swagger UI ở http://localhost:3000/api/docs. Tắt khi chạy production thật.
API_DOCS_ENABLED=true

# Cặp khoá Ed25519 (PEM, xuống dòng viết \n) ký access token. Không đặt thì mỗi tiến trình tự sinh khoá tạm:
# chạy api cùng realtime thì token của api không qua được realtime. Lệnh sinh hai dòng này: README, "Chạy song song".
# Bỏ dấu # khi dùng; để dòng trống (JWT_PRIVATE_KEY=) thì server không khởi động được.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Số lần gọi đăng nhập, đăng ký mỗi 15 phút cho một IP
AUTH_RATE_LIMIT=20
# Số tầng proxy đứng trước api (staging sau Caddy: 1). Máy dev: 0
TRUST_PROXY_HOPS=0

# Khớp với deploy/compose.yaml (chỉ dùng cho máy dev)
DATABASE_URL=postgres://commerio:commerio@localhost:5432/commerio

# Kafka (deploy/compose.yaml). Chạy nhiều worktree cùng lúc: mỗi worktree một tiền tố topic (README)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=commerio
KAFKA_TOPIC_PREFIX=commerio

# Cổng thanh toán (sandbox), bỏ dấu # khi dùng. Khoá mã hoá khoá cổng lưu trong DB, 32 byte base64: openssl rand -base64 32
# PAYMENT_CREDENTIALS_KEY=
# URL công khai của api cho IPN và trang quay về, vd https://abc.trycloudflare.com
# PUBLIC_API_URL=
# Gốc URL công khai của FE (không query, không #), trang khách quay về sau khi trả tiền là <PUBLIC_WEB_URL>/thanh-toan/ket-qua, vd http://localhost:5173
# PUBLIC_WEB_URL=

# OAuth client ID loại Web của Google cho đăng nhập Google (README mục Đăng nhập Google). Không cần client secret
# GOOGLE_CLIENT_ID=

# Gửi thư OTP mời nhân viên (worker). Máy dev dùng Mailpit trong deploy/compose.yaml, xem thư ở http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Commerio <no-reply@commerio.local>
# Staging dùng Gmail: bật xác minh 2 bước cho tài khoản Gmail, tạo App Password (16 ký tự, bỏ khoảng trắng),
# viết @ trong địa chỉ thành %40. MAIL_FROM phải là chính địa chỉ đó. Không commit giá trị thật.
# SMTP_URL=smtps://ten%40gmail.com:<app-password>@smtp.gmail.com:465
# MAIL_FROM=Commerio <ten@gmail.com>

# Mật khẩu chung của 4 tài khoản demo khi chạy npm run db:seed (ít nhất 8 ký tự, có chữ và số)
# SEED_PASSWORD=
