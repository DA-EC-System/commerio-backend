# Sao chép thành .env rồi sửa. Không commit .env.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=3000
API_OPS_PORT=9464
WORKER_PORT=3001
REALTIME_PORT=3002

# Swagger UI ở http://localhost:3000/api/docs. Tắt khi chạy production thật.
API_DOCS_ENABLED=true

# Cặp khoá Ed25519 (PEM, xuống dòng viết \n) ký access token. Bỏ trống thì máy dev tự sinh khoá tạm.
# Sinh: openssl genpkey -algorithm ed25519 -out jwt.pem && openssl pkey -in jwt.pem -pubout
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Số lần gọi đăng nhập, đăng ký mỗi 15 phút cho một IP
AUTH_RATE_LIMIT=20

# Khớp với deploy/compose.yaml (chỉ dùng cho máy dev)
DATABASE_URL=postgres://commerio:commerio@localhost:5432/commerio
