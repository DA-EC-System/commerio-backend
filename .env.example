# Sao chép thành .env rồi sửa. Không commit .env.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=3000
API_OPS_PORT=9464
WORKER_PORT=3001
REALTIME_PORT=3002

# Swagger UI ở http://localhost:3000/api/docs. Tắt khi chạy production thật.
API_DOCS_ENABLED=true

# Cặp khoá Ed25519 (PEM, xuống dòng viết \n) ký access token. Không đặt thì mỗi tiến trình tự sinh khoá tạm:
# chạy api cùng realtime thì token của api không qua được realtime. Lệnh sinh hai dòng này: README, "Chạy song song".
# Bỏ dấu # khi dùng; để dòng trống (JWT_PRIVATE_KEY=) thì server không khởi động được.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Số lần gọi đăng nhập, đăng ký mỗi 15 phút cho một IP
AUTH_RATE_LIMIT=20
# Số tầng proxy đứng trước api (staging sau Caddy: 1). Máy dev: 0
TRUST_PROXY_HOPS=0

# Khớp với deploy/compose.yaml (chỉ dùng cho máy dev)
DATABASE_URL=postgres://commerio:commerio@localhost:5432/commerio

# Kafka (deploy/compose.yaml). Chạy nhiều worktree cùng lúc: mỗi worktree một tiền tố topic (README)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=commerio
KAFKA_TOPIC_PREFIX=commerio

# Cổng thanh toán (sandbox), bỏ dấu # khi dùng. Khoá mã hoá khoá cổng lưu trong DB, 32 byte base64: openssl rand -base64 32
# PAYMENT_CREDENTIALS_KEY=
# URL công khai của api cho IPN và trang quay về, vd https://abc.trycloudflare.com
# PUBLIC_API_URL=
