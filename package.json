{
  "name": "commerio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/entrypoints/api.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env src/entrypoints/worker.ts",
    "dev:realtime": "node --watch --env-file-if-exists=.env src/entrypoints/realtime.ts",
    "start": "node src/entrypoints/api.ts",
    "start:worker": "node src/entrypoints/worker.ts",
    "start:realtime": "node src/entrypoints/realtime.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run depcruise && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "infra:up": "docker compose -f deploy/compose.yaml up -d",
    "infra:down": "docker compose -f deploy/compose.yaml down"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dependency-cruiser": "^18.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
